{
  "name": "kern-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Kern umbrella dev workspace + self-host distribution",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "bash scripts/dev-setup.sh",
    "infra": "docker compose -f dev/compose.yml up -d",
    "infra:down": "docker compose -f dev/compose.yml down",
    "infra:reset": "docker compose -f dev/compose.yml down -v",
    "dev": "bash scripts/run-all.sh dev --parallel",
    "build": "bash scripts/run-all.sh build",
    "lint": "bash scripts/run-all.sh lint && pnpm check:repos && pnpm check:messages",
    "check:messages": "node scripts/check-messages.mjs --all-modules",
    "check:repos": "node scripts/check-repos.mjs",
    "typecheck": "bash scripts/run-all.sh typecheck",
    "test": "bash scripts/run-all.sh test",
    "db:migrate": "bash scripts/run-all.sh db:migrate",
    "format": "biome format --write .",
    "status": "bash scripts/status.sh",
    "pull": "bash scripts/pull-all.sh",
    "check:clean": "bash scripts/status.sh --quiet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "turbo": "^2.10.0",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/api-key": "1.7.1",
      "@better-auth/core": "1.7.1",
      "@better-auth/passkey": "1.7.1",
      "@better-auth/sso": "1.7.1",
      "@kernhq/contracts": "workspace:*",
      "@kernhq/kernel": "workspace:*",
      "@kernhq/module-billing": "workspace:*",
      "@kernhq/module-chat": "workspace:*",
      "@kernhq/module-hr": "workspace:*",
      "@kernhq/module-inventory": "workspace:*",
      "@kernhq/module-mail": "workspace:*",
      "@kernhq/module-quire": "workspace:*",
      "@kernhq/module-tracker": "workspace:*",
      "@kernhq/sdk": "workspace:*",
      "@kernhq/ui": "workspace:*",
      "@kernhq/workflow": "workspace:*",
      "better-auth": "1.7.1"
    }
  }
}
