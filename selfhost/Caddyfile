{
	email {$ACME_EMAIL}
}

{$KERN_DOMAIN} {
	encode zstd gzip

	# realtime + chat service
	@chat path /api/chat/* /ws /ws/*
	handle @chat {
		reverse_proxy chat:4100
	}
	# mail service
	handle_path /api/mail/* {
		rewrite * /api/mail{uri}
		reverse_proxy mail:4200
	}
	# collaborative editing (Yjs)
	handle /collab* {
		reverse_proxy collab:4300
	}
	# LiveKit signalling. Nothing in Kern uses it — calls are not built, and .env.example says so.
	#
	# LiveKit serves its signalling WebSocket at /rtc, so the prefix is stripped: a request for
	# /livekit/rtc reaches LiveKit as /rtc, and /livekit/rtc/validate as /rtc/validate. Media does
	# not pass through Caddy at all; it goes to 7882/udp, or 7881/tcp where a network blocks UDP.
	#
	# Namespaced under /livekit rather than taking /rtc at the root, and only those two paths.
	# LiveKit's twirp admin API creates rooms and removes participants, so it is deliberately not
	# routed from the edge: /livekit/twirp/... falls through to the app below. livekit:7880 is not
	# published by docker-compose.yml either, so this route is the only way in from outside.
	#
	# The livekit service is behind `--profile calls`, which a default install does not pass. With no
	# such container this route answers 502 and every other route is unchanged — measured on
	# 2026-09-06 by running this file in a caddy container against stub upstreams.
	@livekit path /livekit/rtc /livekit/rtc/*
	handle @livekit {
		uri strip_prefix /livekit
		reverse_proxy livekit:7880
	}
	# object storage (presigned URLs)
	#
	# NO path stripping, and the route is the bucket name rather than a prefix of our own. A
	# presigned URL is a SigV4 signature over the canonical path, so MinIO recomputes the signature
	# from the path it receives: it has to receive the byte-identical path core signed. The prefix
	# this used to carry (`handle_path /s3/*`, with S3_PUBLIC_ENDPOINT=https://<domain>/s3) signed
	# `/s3/<bucket>/<key>` and delivered `/<bucket>/<key>`, so every upload and every download on
	# every self-host install failed with 403 SignatureDoesNotMatch. A path prefix can never work
	# here unless the origin sees the prefix too.
	#
	# So S3_PUBLIC_ENDPOINT is the bare origin and the signed path starts with the bucket. `kern` is
	# in core's RESERVED_SLUGS, so no workspace can ever live at /kern and shadow this.
	#
	# Same-origin, which is why nothing configures CORS: the browser PUTs to the page's own origin.
	# If you would rather keep storage off the app domain — a CDN or WAF in front that caps request
	# bodies is the usual reason; Cloudflare's is 100 MB against signed PUTs of up to 500 MB — add a
	# second site block and point S3_PUBLIC_ENDPOINT at it instead. That name needs its own DNS
	# record, and it makes the upload cross-origin, so the bucket needs CORS allowing your app
	# origin with ETag exposed:
	#
	#     files.{$KERN_DOMAIN} {
	#         reverse_proxy minio:9000
	#     }
	handle /kern/* {
		reverse_proxy minio:9000
	}
	# MCP, and the OAuth discovery documents an MCP client fetches before it connects.
	#
	# core serves all of these at the ROOT of its Fastify app rather than under /api — the paths are
	# fixed by the MCP and RFC 8414/9728 specifications, so core cannot move them behind the prefix.
	# `handle /api/*` below therefore never saw them and they fell through to the catch-all, which
	# answered every one with the SvelteKit app's HTML. An MCP client reads that as a malformed
	# discovery document and gives up, so MCP was unreachable on every shipped topology.
	#
	# The endpoints this document advertises (authorize, token, register, revoke) live under
	# /api/mcp/oauth/* and are already routed by the block below.
	@mcp path /mcp /mcp/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server
	handle @mcp {
		reverse_proxy core:4000
	}
	# core API (auth, workspaces, all other modules) + OpenAPI
	handle /api/* {
		reverse_proxy core:4000
	}
	# web app (SvelteKit)
	handle {
		reverse_proxy app:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
		# `frame-ancestors` is ignored in a <meta> tag, so the app cannot set it itself — SvelteKit
		# emits the rest of the policy (it knows which scripts it emits and can nonce them).
		# X-Frame-Options is the same rule for anything that predates CSP.
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options DENY
		# Core sends its own on /api; the shell's HTML is served by Caddy, so Caddy has to say it.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
